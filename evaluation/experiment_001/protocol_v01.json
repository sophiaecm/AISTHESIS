{
  "protocol_name": "Experiment 001 controlled appearance anticipation",
  "protocol_version": "experiment-001-protocol-v0.1",
  "research_question": "Can reconstructing expected but unavailable sensory consequences improve latent-state and near-future event inference under partial observability beyond systems reasoning from the same visible evidence without that reconstruction?",
  "production_reference": "e1c3cf0c80006334408d2f0180f3cd3e332a4ff6",
  "conditions": ["A_VISUAL", "B_VISUAL_PHYSICS", "C_FULL", "C_NO_ACOUSTIC", "C_SHUFFLED_ACOUSTIC"],
  "condition_definitions": {
    "A_VISUAL": "existing SmolVLM2 learned visual baseline with common visual prefix and optional common detector/tracking features; no explicit physics or acoustic packet",
    "B_VISUAL_PHYSICS": "A plus frozen physical state and constraints; no experimental acoustic packet",
    "C_FULL": "common visual evidence plus frozen physical, latent and belief context plus inferred acoustic packet; matched to C_NO_ACOUSTIC in all other respects",
    "C_NO_ACOUSTIC": "same C runner with all acoustic candidates, derived descriptions, references and downstream acoustic features removed",
    "C_SHUFFLED_ACOUSTIC": "same C runner with only the acoustic packet replaced by split-local donor-prefix packet; donor audit identity kept out of inference"
  },
  "ablation_identifiers": ["C_NO_ACOUSTIC", "C_SHUFFLED_ACOUSTIC"],
  "primary_comparisons": ["C_FULL versus C_NO_ACOUSTIC", "C_FULL versus C_SHUFFLED_ACOUSTIC"],
  "target_semantics": "appearance_actor_category_region_exact_v1",
  "event_onset_rule": "first_visible_frame_in_monitoring_interval_confirmed_next_frame_v1",
  "onset_annotation": {"minimum_connected_visible_pixels_in_region": 16, "consecutive_confirming_frames": 2, "masks": "manual_source_frame_annotation_only", "onset_timestamp": "first_frame_not_confirmation_frame"},
  "anticipation_rule": "one_exact_category_region_commitment_per_frame_before_onset_within_horizon_v1",
  "horizon_seconds": 2.0,
  "units": "seconds",
  "tta_definition": "event_onset_timestamp minus earliest_valid_issuance_timestamp",
  "tta_missing": null,
  "negative_trial_policy": "complete_annotation_no_target_event_is_negative_missing_is_not_negative",
  "false_anticipation_policy": "resolved_incorrect_pre_event_commitments_and_negative_trial_commitments",
  "exclusion_policy": "retain_missing_ambiguous_censored_timing_and_log_failures_separately_never_as_incorrect",
  "metric_identifiers": ["exp001.valid_anticipation_coverage", "exp001.strict_target_event_precision", "exp001.tta_seconds", "exp001.negative_trial_false_alarm_fraction", "exp001.false_commitment_fraction", "exp001.false_commitment_count", "exp001.excluded_fraction", "exp001.prediction_log_coverage"],
  "denominators": {
    "exp001.valid_anticipation_coverage": "eligible_positive_trials_with_complete_condition_logs",
    "exp001.strict_target_event_precision": "all_resolved_pre_event_and_negative_trial_commitments",
    "exp001.tta_seconds": "eligible_positive_trials_with_valid_anticipation_report_selection_count",
    "exp001.negative_trial_false_alarm_fraction": "eligible_negative_trials_with_complete_condition_logs",
    "exp001.false_commitment_fraction": "all_resolved_pre_event_and_negative_trial_commitments",
    "exp001.excluded_fraction": "all_supplied_trials",
    "exp001.prediction_log_coverage": "all_scheduled_condition_cutoffs"
  },
  "weighted_outcome_score": "secondary_only_for_unchanged_step27c_geometric_contract_not_event_labels",
  "probability_metric_eligibility": {"brier_score": "ineligible", "nll": "ineligible", "ece": "ineligible"},
  "shuffle_policy": "split_cutoff_group_sorted_sequence_ids_next_rotation_no_self_singleton_unavailable_v1",
  "shuffle_packet_fields": ["event_family", "status", "uncertainty"],
  "shuffle_packet_empty_policy": "empty_available_packet_participates_missing_packet_does_not; coverage_reported",
  "physics_removal": "deferred_confounds_acoustic_generation_prerequisites",
  "flybrain_boundary": "FLYBRAIN IMPLEMENTATION NOT PRESENT IN CORE; separate optional later branch with identical inputs and evaluation",
  "scientific_status": "EXPERIMENT NOT YET RUN; HYPOTHESIS NOT YET SUPPORTED",
  "run_readiness": "blocked_until_dataset_and_runner_preregistration",
  "required_before_run": ["dataset_hashes_splits_sample_count_stopping_rule", "annotation_manual_region_category_vocabulary_and_blinded_adjudication", "common_frame_schedule_and_timestamp_validation", "model_snapshot_prompt_adapter_and_budget_hashes", "condition_ablation_and_shuffle_adapter_audits", "fixed_seeds_and_environment", "analysis_plan_descriptive_or_preregistered_inferential"],
  "result_policy": "no_results_in_protocol_no_posthoc_tuning_no_global_composite"
